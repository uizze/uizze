diff --git a/app.js b/app.js
index 780262b..7f2b5a9 100644
--- a/app.js
+++ b/app.js
@@ -1,7 +1,75 @@
 const app = document.querySelector('#app');
-const state = new URLSearchParams(window.location.search).get('state') || 'default';
+const states = new Set(['default', 'loading', 'empty', 'failed', 'success']);
+const requestedState = new URLSearchParams(location.search).get('state');
+const state = states.has(requestedState) ? requestedState : 'default';
 
-app.innerHTML = `
-  <h1>Billing</h1>
-  <p>This route is intentionally incomplete. Implement the requested billing workflow for the <strong>${state}</strong> state.</p>
-`;
+const invoice = {
+  number: 'INV-2026-0718',
+  date: 'Jul 18, 2026',
+  amount: '$24.00',
+  status: 'Paid',
+};
+
+const changeState = (next) => location.assign(`?state=${next}`);
+
+const invoiceRow = () => `
+  <article class="invoice" aria-label="Invoice ${invoice.number}">
+    <div><strong>${invoice.number}</strong><span>${invoice.date}</span></div>
+    <div class="invoice-actions"><span class="status status-success">${invoice.status}</span><strong>${invoice.amount}</strong><details class="invoice-details"><summary>View invoice</summary><p>Pro plan · Jul 18–Aug 18, 2026</p></details><button class="text-button" type="button" data-receipt>Download receipt</button></div>
+  </article>`;
+
+const statesView = {
+  loading: `
+    <header class="page-heading"><p class="eyebrow">Settings</p><h1>Billing</h1><p>Manage your subscription, payment method, and billing history.</p></header>
+    <section class="card" aria-busy="true" aria-label="Loading billing information"><div class="skeleton title-skeleton"></div><div class="skeleton"></div><div class="skeleton short"></div></section>
+    <section class="card"><div class="skeleton title-skeleton"></div><div class="skeleton"></div></section>`,
+  empty: `
+    <header class="page-heading"><p class="eyebrow">Settings</p><h1>Billing</h1><p>Manage your subscription, payment method, and billing history.</p></header>
+    ${billingCards()}
+    <section class="section"><div class="section-heading"><div><h2>Invoices</h2><p>Your billing history will appear here.</p></div></div><div class="empty-state"><span aria-hidden="true">▧</span><h3>No invoices yet</h3><p>Invoices will be available after your first completed payment.</p></div></section>`,
+  failed: `
+    <header class="page-heading"><p class="eyebrow">Settings</p><h1>Billing</h1><p>Manage your subscription, payment method, and billing history.</p></header>
+    <section class="notice notice-danger" role="alert"><div><strong>Payment failed</strong><p>We couldn’t collect $24.00 for your Pro plan on Jul 25. Update your payment method or try the payment again.</p></div><button class="button button-danger" type="button" data-retry>Retry payment</button></section>
+    ${billingCards()}
+    ${invoicesSection()}`,
+  success: `
+    <header class="page-heading"><p class="eyebrow">Settings</p><h1>Billing</h1><p>Manage your subscription, payment method, and billing history.</p></header>
+    <section class="notice notice-success" role="status"><div><strong>Payment method updated</strong><p>Your new Visa ending in 4242 is now saved for future payments.</p></div></section>
+    ${billingCards('Visa ending in 4242')}
+    ${invoicesSection()}`,
+  default: `
+    <header class="page-heading"><p class="eyebrow">Settings</p><h1>Billing</h1><p>Manage your subscription, payment method, and billing history.</p></header>
+    ${billingCards()}
+    ${invoicesSection()}`,
+};
+
+function billingCards(paymentMethod = 'Visa ending in 0189') {
+  return `
+    <section class="cards" aria-label="Subscription and payment details">
+      <article class="card"><div class="card-heading"><div><h2>Current plan</h2><p>Pro plan</p></div><span class="status">Active</span></div><p class="price">$24 <span>per month</span></p><p>Renews on Aug 18, 2026. Includes up to 10 team members.</p></article>
+      <article class="card"><div class="card-heading"><div><h2>Payment method</h2><p>${paymentMethod}</p></div><span class="card-icon" aria-hidden="true">▣</span></div><p>Expires 08/28</p><button class="button button-secondary" type="button" data-change-payment>Replace payment method</button></article>
+    </section>`;
+}
+
+function invoicesSection() {
+  return `<section class="section"><div class="section-heading"><div><h2>Invoices</h2><p>Download a receipt for any completed payment.</p></div></div><div class="invoice-list">${invoiceRow()}</div></section>`;
+}
+
+app.innerHTML = statesView[state];
+
+app.addEventListener('click', (event) => {
+  if (event.target.closest('[data-change-payment]')) document.querySelector('#payment-dialog').showModal();
+  if (event.target.closest('[data-retry]')) changeState('loading');
+  if (event.target.closest('[data-receipt]')) downloadReceipt();
+});
+
+document.querySelector('#payment-dialog').addEventListener('close', (event) => {
+  if (event.target.returnValue === 'saved') changeState('success');
+});
+
+function downloadReceipt() {
+  const receipt = `Ledgerly receipt\nInvoice: ${invoice.number}\nDate: ${invoice.date}\nAmount: ${invoice.amount}\nStatus: ${invoice.status}\n`;
+  const link = Object.assign(document.createElement('a'), { href: URL.createObjectURL(new Blob([receipt], { type: 'text/plain' })), download: `${invoice.number}-receipt.txt` });
+  link.click();
+  URL.revokeObjectURL(link.href);
+}
