diff --git a/app.js b/app.js
index 780262b..c9020f1 100644
--- a/app.js
+++ b/app.js
@@ -1,7 +1,102 @@
 const app = document.querySelector('#app');
-const state = new URLSearchParams(window.location.search).get('state') || 'default';
+const validStates = new Set(['default', 'loading', 'empty', 'failed', 'success']);
+const requestedState = new URLSearchParams(window.location.search).get('state') || 'default';
+const state = validStates.has(requestedState) ? requestedState : 'default';
 
-app.innerHTML = `
-  <h1>Billing</h1>
-  <p>This route is intentionally incomplete. Implement the requested billing workflow for the <strong>${state}</strong> state.</p>
-`;
+const invoiceRows = `
+  <div class="invoice-table" role="region" aria-label="Invoice history" tabindex="0">
+    <table>
+      <caption class="sr-only">Invoice history</caption>
+      <thead><tr><th scope="col">Invoice</th><th scope="col">Date</th><th scope="col">Amount</th><th scope="col">Status</th><th scope="col"><span class="sr-only">Receipt</span></th></tr></thead>
+      <tbody>
+        <tr><td>INV-2026-07</td><td>Jul 12, 2026</td><td>$49.00</td><td>Paid</td><td><button class="link-button" type="button" data-download="INV-2026-07">Download receipt</button></td></tr>
+        <tr><td>INV-2026-06</td><td>Jun 12, 2026</td><td>$49.00</td><td>Paid</td><td><button class="link-button" type="button" data-download="INV-2026-06">Download receipt</button></td></tr>
+        <tr><td>INV-2026-05</td><td>May 12, 2026</td><td>$49.00</td><td>Paid</td><td><button class="link-button" type="button" data-download="INV-2026-05">Download receipt</button></td></tr>
+      </tbody>
+    </table>
+  </div>`;
+
+const paymentMethod = `
+  <section class="section" aria-labelledby="payment-method-heading">
+    <div class="section-heading"><div><h2 id="payment-method-heading">Payment method</h2><p>Visa ending in 4242 · Expires 08/28</p></div><button class="secondary-button" type="button" data-action="replace">Replace card</button></div>
+    <form class="replace-form" hidden aria-label="Replace saved payment method">
+      <div class="form-grid">
+        <label>Card number<input name="card-number" inputmode="numeric" autocomplete="cc-number" aria-describedby="card-number-help" required /><span class="field-help" id="card-number-help">Enter the full number from your card.</span></label>
+        <label>Expiry<input name="expiry" inputmode="numeric" autocomplete="cc-exp" aria-describedby="expiry-help" required /><span class="field-help" id="expiry-help">Month and year.</span></label>
+        <label>Security code<input name="cvc" inputmode="numeric" autocomplete="cc-csc" aria-describedby="cvc-help" required /><span class="field-help" id="cvc-help">The 3-digit code.</span></label>
+      </div>
+      <div class="form-actions"><button class="primary-button" type="submit">Save payment method</button><button class="quiet-button" type="button" data-action="cancel-replace">Cancel</button></div>
+    </form>
+  </section>`;
+
+function layout({ notice = '', invoices = invoiceRows, method = paymentMethod }) {
+  return `
+    <header class="page-header"><h1>Billing</h1><p>Manage your workspace plan, payment method, and invoices.</p></header>
+    ${notice}
+    <section class="section" aria-labelledby="plan-heading">
+      <div class="section-heading"><div><h2 id="plan-heading">Current plan</h2><p>Team plan · $49 per month</p></div><a class="text-link" href="mailto:billing@ledgerly.example?subject=Plan%20change">Change plan</a></div>
+      <p class="detail">Renews on August 12, 2026. Includes up to 10 members.</p>
+    </section>
+    ${method}
+    <section class="section" aria-labelledby="invoices-heading">
+      <div class="section-heading"><div><h2 id="invoices-heading">Invoices</h2><p>Receipts are available for paid invoices.</p></div></div>
+      ${invoices}
+    </section>`;
+}
+
+const loadingContent = `
+  <header class="page-header"><h1>Billing</h1><p>Retrieving your billing details.</p></header>
+  <div class="loading-block" role="status"><span class="spinner" aria-hidden="true"></span><span>Loading billing details…</span></div>
+  <div class="skeleton-lines" aria-hidden="true"><i></i><i></i><i></i><i></i></div>`;
+
+const emptyInvoices = `<div class="empty-message"><h3>No invoices yet</h3><p>Your invoice history will appear here after your first paid billing cycle.</p></div>`;
+const failedNotice = `<section class="notice notice-danger" role="alert" aria-labelledby="payment-failed-heading"><div><h2 id="payment-failed-heading">Your July 12 payment did not go through</h2><p>Your card ending in 4242 was declined for $49.00. Update the card or retry the payment to keep your Team plan active.</p></div><button class="primary-button" type="button" data-action="retry">Retry payment</button></section>`;
+const successNotice = `<section class="notice notice-success" role="status" aria-labelledby="payment-updated-heading"><div><h2 id="payment-updated-heading">Payment method replaced</h2><p>Your new Visa ending in 6789 will be used for future invoices.</p></div></section>`;
+
+if (state === 'loading') app.innerHTML = loadingContent;
+else if (state === 'empty') app.innerHTML = layout({ invoices: emptyInvoices });
+else if (state === 'failed') app.innerHTML = layout({ notice: failedNotice });
+else if (state === 'success') app.innerHTML = layout({ notice: successNotice });
+else app.innerHTML = layout({});
+
+function goTo(nextState) {
+  const url = new URL(window.location.href);
+  url.searchParams.set('state', nextState);
+  window.location.assign(url);
+}
+
+app.addEventListener('click', (event) => {
+  const button = event.target.closest('button');
+  if (!button) return;
+  if (button.dataset.action === 'replace') {
+    const form = app.querySelector('.replace-form');
+    form.hidden = false;
+    button.hidden = true;
+    form.querySelector('input').focus();
+  }
+  if (button.dataset.action === 'cancel-replace') {
+    const form = app.querySelector('.replace-form');
+    form.reset();
+    form.hidden = true;
+    app.querySelector('[data-action="replace"]').hidden = false;
+    app.querySelector('[data-action="replace"]').focus();
+  }
+  if (button.dataset.action === 'retry') goTo('loading');
+  if (button.dataset.download) {
+    const invoice = button.dataset.download;
+    const receipt = `Ledgerly receipt\nInvoice: ${invoice}\nPlan: Team\nAmount: $49.00\nStatus: Paid\n`;
+    const link = document.createElement('a');
+    link.href = URL.createObjectURL(new Blob([receipt], { type: 'text/plain' }));
+    link.download = `${invoice}-receipt.txt`;
+    link.click();
+    URL.revokeObjectURL(link.href);
+  }
+});
+
+app.addEventListener('submit', (event) => {
+  if (!event.target.matches('.replace-form')) return;
+  event.preventDefault();
+  goTo('success');
+});
+
+if (state === 'loading') window.setTimeout(() => goTo('default'), 900);
